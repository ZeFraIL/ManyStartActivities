<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- CameraX Live Preview Layer -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewViewCamera"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay Framing & Mask -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top Privacy Disclaimer Banner -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="#D9000000"
            app:cardCornerRadius="16dp"
            app:strokeColor="#38BDF8"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="@string/v24_privacy_disclaimer"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="#E2E8F0" />

        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Face Mask Overlay Circle -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCameraOverlay"
            android:layout_width="220dp"
            android:layout_height="220dp"
            app:cardBackgroundColor="#33000000"
            app:cardCornerRadius="110dp"
            app:cardElevation="8dp"
            app:strokeColor="#38BDF8"
            app:strokeWidth="3dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="32dp">

                <ImageView
                    android:id="@+id/ivCameraLogoMask"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.8"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/logo" />

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvCameraPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:background="#99000000"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="@string/v24_snap_prompt"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
