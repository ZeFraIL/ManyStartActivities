<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvUnboxingPrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        android:text="@string/v10_prompt"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold" />

    <!-- Container for Logo / Gift Content -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardGiftBox"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_centerInParent="true"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="2dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp">

            <ImageView
                android:id="@+id/ivGiftLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:src="@drawable/logo" />

            <!-- Ribbon & Bow Overlay -->
            <RelativeLayout
                android:id="@+id/layoutRibbon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#D9B71C1C">

                <!-- Vertical Ribbon Strand -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:layout_centerHorizontal="true"
                    android:background="#FFD700" />

                <!-- Horizontal Ribbon Strand -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_centerVertical="true"
                    android:background="#FFD700" />

                <!-- Center Bow Icon / Knot -->
                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_centerInParent="true"
                    android:contentDescription="@string/v10_title"
                    android:src="@android:drawable/btn_star_big_on" />

            </RelativeLayout>

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>
