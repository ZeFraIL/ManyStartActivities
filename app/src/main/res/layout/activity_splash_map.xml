<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E293B">

    <!-- Map Tile Grid Background Simulation -->
    <RelativeLayout
        android:id="@+id/layoutMapGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F172A">

        <!-- Grid Lines -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_centerVertical="true"
            android:background="#334155" />

        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:background="#334155" />

        <!-- Coordinates Radar Overlay -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="48dp"
            android:background="#CC000000"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPS TARGET: 31.2530° N, 34.7915° E"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="#38BDF8"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMapStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/v19_status"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="#94A3B8" />

        </LinearLayout>

        <!-- Pin Marker Container (Center) -->
        <LinearLayout
            android:id="@+id/layoutPinMarker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="90dp"
                android:layout_height="90dp"
                app:cardCornerRadius="45dp"
                app:cardElevation="12dp"
                app:strokeColor="#38BDF8"
                app:strokeWidth="3dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/app_name"
                    android:padding="12dp"
                    android:src="@drawable/logo" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Pin Tail Arrow -->
            <View
                android:layout_width="4dp"
                android:layout_height="24dp"
                android:background="#38BDF8" />

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="#38BDF8" />

        </LinearLayout>

    </RelativeLayout>

</FrameLayout>
